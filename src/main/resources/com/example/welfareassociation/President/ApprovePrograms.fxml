<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.welfareassociation.President.ApproveProgramsController">
   <children>
      <Label layoutX="293.0" layoutY="28.0" />
      <Label layoutX="312.0" layoutY="28.0" text="Program Approval" />
      <TableView fx:id="pendingProgramsTableView" layoutX="65.0" layoutY="70.0" prefHeight="200.0" prefWidth="200.0">
        <columns>
          <TableColumn prefWidth="75.0" text="C1" />
          <TableColumn prefWidth="75.0" text="C2" />
        </columns>
      </TableView>
      <TextArea fx:id="programDetailsTextArea" layoutX="312.0" layoutY="59.0" prefHeight="200.0" prefWidth="200.0" text="          Program Details" />
      <Button layoutX="65.0" layoutY="303.0" mnemonicParsing="false" onAction="#handleApproveButton" text="Approve" />
      <Button layoutX="222.0" layoutY="303.0" mnemonicParsing="false" onAction="#handleRejectButton" text="Reject" />
      <Button layoutX="371.0" layoutY="303.0" mnemonicParsing="false" onAction="#handleBackButton" text="Back" />
   </children>
</AnchorPane>
