<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>


<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.welfareassociation.President.GenerateReportController">
   <children>
      <Label layoutX="325.0" layoutY="27.0" text="Performance Report" />
      <ComboBox fx:id="reportTypeComboBox" layoutX="47.0" layoutY="71.0" prefWidth="150.0" />
      <TableView fx:id="reportTableView" layoutX="39.0" layoutY="142.0" prefHeight="200.0" prefWidth="200.0">
        <columns>
          <TableColumn prefWidth="75.0" text="C1" />
          <TableColumn prefWidth="75.0" text="C2" />
        </columns>
      </TableView>
      <Button layoutX="300.0" layoutY="71.0" mnemonicParsing="false" onAction="#handleGenerateButton" text="Generate" />
      <Button layoutX="300.0" layoutY="142.0" mnemonicParsing="false" onAction="#handleBackButton" text="Back" />
   </children>
</AnchorPane>
